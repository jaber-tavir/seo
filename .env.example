# ============================================================
# Application
# ============================================================
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ============================================================
# MySQL database (Laragon defaults: root with empty password)
# ============================================================
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=seo_tools
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_POOL_MAX=10

# ============================================================
# Redis (BullMQ queues, caching, rate limiting, job progress)
# ============================================================
REDIS_URL=redis://127.0.0.1:6379

# ============================================================
# Crawler (Phase 2 site audit)
# ============================================================
CRAWLER_MAX_PAGES=5000
CRAWLER_MAX_DEPTH=3
CRAWLER_CONCURRENCY=5
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_BODY_BYTES=5000000
CRAWLER_USER_AGENT=SEOAuditBot/1.0 (+https://localhost)
CRAWLER_CRAWL_DELAY_MAX_MS=10000

# ============================================================
# Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================
AUTH_SECRET=change-me-to-a-long-random-string-in-production
AUTH_SESSION_TTL_DAYS=30
# Set to "true" in production. When "false" (dev) users are active immediately.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Google OAuth (optional - enables "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Stripe billing (Phase 9)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# External data providers (real SEO metrics - Phase 2/4/5/6)
# ============================================================
PAGESPEED_API_KEY=
# DataForSEO credentials also back the keyword provider (Phases 4/5)
# and the backlink provider (Phase 6). When unset, app uses the
# clearly-marked mock providers (nulls, never fabricated numbers).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERP_API_KEY=

# ============================================================
# AI provider (Phase 7)
# ============================================================
AI_API_KEY=

# ============================================================
# Email / SMTP (leave empty to log emails to server console in dev)
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SEO Tools <no-reply@localhost>

# ============================================================
# Testing (integration tests use a dedicated database)
# ============================================================
TEST_DATABASE_NAME=seo_tools_test
