{
  "name": "seo_tools",
  "version": "0.1.0",
  "private": true,
  "description": "All-in-One SEO SaaS platform - Next.js + MySQL + Sequelize + Redis",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "migrate": "node --import tsx src/database/migrate.ts up",
    "migrate:undo": "node --import tsx src/database/migrate.ts down",
    "migrate:status": "node --import tsx src/database/migrate.ts status",
    "db:seed": "node --import tsx src/database/seed.ts",
    "worker:crawl": "node --import tsx src/jobs/worker.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tanstack/react-query": "^5.66.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.474.0",
    "mysql2": "^3.24.4",
    "next": "^15.3.0",
    "next-themes": "^0.4.4",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "sequelize": "^6.37.5",
    "sonner": "^1.7.2",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.2.5",
    "umzug": "^3.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
